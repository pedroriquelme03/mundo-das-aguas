{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip-root-install",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/pages/links.html",
      "destination": "/bio",
      "permanent": true
    },
    {
      "source": "/pages/links",
      "destination": "/bio",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "/bio",
      "permanent": true
    },
    {
      "source": "/links.html",
      "destination": "/bio",
      "permanent": true
    }
  ]
}
